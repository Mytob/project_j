{
	admin unix//run/caddy-admin/admin.sock|0220
}

domain.test {
	tls internal
	root * /srv/site
	file_server
}

admin.domain.test {
	tls internal
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	respond /robots.txt "User-agent: *\nDisallow: /\n" 200
	jp_admin_bans
	reverse_proxy admin-origin:8080 {
		header_up X-JP-Client-IP {http.request.remote.host}
	}
}

access.domain.test {
	tls internal
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	respond /robots.txt "User-agent: *\nDisallow: /\n" 200
	route {
		jp_proxy_metrics
		import /etc/caddy/whitelist.caddy
	}
}
