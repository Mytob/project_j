{
	admin unix//run/caddy-admin/admin.sock|0220
}

{$BASE_DOMAIN} {
	root * /srv/site/current
	handle_errors 403 404 502 503 {
		rewrite /errors/{err.status_code}.html
		file_server
	}
	file_server
}

admin.{$BASE_DOMAIN} {
	jp_admin_bans
	reverse_proxy admin-origin:8080 {
		header_up X-JP-Client-IP {http.request.remote.host}
	}
}

access.{$BASE_DOMAIN} {
	root * /srv/site/current
	handle_errors 403 404 502 503 {
		rewrite /errors/{err.status_code}.html
		file_server
	}
	route {
		jp_proxy_metrics
		import /etc/caddy/whitelist.caddy
	}
}
