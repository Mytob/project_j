FROM golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/mock-jellyfin ./cmd/mock-jellyfin
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/mock-jellyfin ./cmd/mock-jellyfin

FROM scratch
COPY --from=build /out/mock-jellyfin /mock-jellyfin
EXPOSE 8096
ENTRYPOINT ["/mock-jellyfin"]
